     <item>
      <widget class="QPushButton" name="cancel_button">

       <property name="text">
        <string>Cancel</string>
       </property>

      </widget>
     </item>

     <item>
      <widget class="QPushButton" name="save_button">

       <property name="text">
        <string>Save</string>
       </property>

       <property name="default">
        <bool>true</bool>
       </property>

      </widget>
     </item>

    </layout>
   </item>

  </layout>
 </widget>

